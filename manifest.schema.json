{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tacet-recording-manifest-v2",
  "title": "Tacet recording manifest entry (v2)",
  "description": "Data contract for one recording session entry in manifest.json. One entry may carry 1-2 channels (e.g. the two coherent RX channels of a Pluto+). v2 adds governance fields (contributor, source, consent, site_anonymized) and proper experiment labeling: band is ALWAYS the physical band, label is the ML signal class, condition is the experimental condition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "timestamp",
    "device",
    "protocol",
    "purpose",
    "center_freq_hz",
    "sample_rate_sps",
    "format",
    "duration_s",
    "channels",
    "antenna",
    "operator_notes",
    "band",
    "label",
    "condition",
    "distance_m",
    "environment",
    "los",
    "contributor",
    "source",
    "consent",
    "site_anonymized"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0",
      "description": "Manifest contract version this entry conforms to."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable recording identifier, unique across the manifest."
    },
    "timestamp": {
      "type": "string",
      "description": "Capture start time, ISO 8601 with timezone."
    },
    "device": {
      "enum": ["hackrf", "pluto_plus", "rtl_sdr", "esp32", "other"]
    },
    "protocol": {
      "enum": ["elrs", "dji_o4", "dji_o3", "analog_fpv", "fm_carrier", "dvbt", "noise", "other"],
      "description": "Physical protocol present in the recording (label is the ML class)."
    },
    "purpose": {
      "enum": ["coherence_cal", "signature_capture", "range_test", "dataset_baseline", "other"]
    },
    "center_freq_hz": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sample_rate_sps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "format": {
      "enum": ["cs8", "cs16", "cf32"]
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Path relative to the repo root, inside data/."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "antenna": {
      "type": "string"
    },
    "operator_notes": {
      "type": "string"
    },
    "band": {
      "enum": ["2.4 GHz ISM", "5.8 GHz ISM", "5.1 GHz EU", "UHF DVB-T"],
      "description": "ALWAYS the physical band of center_freq_hz, never a class label."
    },
    "label": {
      "enum": ["elrs", "dji_o4", "analog_fpv", "background", "interference"],
      "description": "ML signal class present in the recording."
    },
    "condition": {
      "enum": ["bench", "flying", "walk", "tx_off"],
      "description": "Experimental condition of the capture."
    },
    "distance_m": {
      "type": ["number", "null"],
      "description": "TX-RX distance in meters; null if not meaningful."
    },
    "environment": {
      "enum": ["indoor_bench", "rural", "urban", "open_field"]
    },
    "los": {
      "type": ["boolean", "null"],
      "description": "Line of sight; null if not meaningful."
    },
    "elrs_profile": {
      "type": ["string", "null"],
      "description": "ELRS packet rate / mode (e.g. D500, 100Hz); log on every ELRS capture. Absent/null when not applicable or not logged."
    },
    "tx_power_dbm": {
      "type": "number",
      "description": "Known transmitter power, if any (receive-only project: usually absent)."
    },
    "gain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["manual", "agc"] },
        "rx1_db": { "type": "number" },
        "rx2_db": { "type": "number" },
        "lna_db": { "type": "number" },
        "vga_db": { "type": "number" }
      }
    },
    "rf_chain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "splitter": {
          "type": "string"
        },
        "cable_len_m": {
          "type": "number"
        }
      }
    },
    "contributor": {
      "type": "string",
      "minLength": 1,
      "description": "Who recorded/contributed this capture (governance)."
    },
    "source": {
      "enum": ["own_capture", "public_dataset", "community"],
      "description": "Provenance of the recording (governance)."
    },
    "consent": {
      "enum": ["private", "cc-by-4.0", "internal"],
      "description": "License/sharing consent for the recording (governance)."
    },
    "site_anonymized": {
      "type": "boolean",
      "description": "True when no site-identifying information is present (governance)."
    }
  }
}
